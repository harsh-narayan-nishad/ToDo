# Copy to .env.local and restart `npm run dev` after changing it.
#
# The backend's API address INCLUDING /api/v1 (same value the main app uses).
# The backend's CORS_ORIGINS must also list this app's address (http://localhost:3002).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# The main Pacewise app (for "Pacewise calendar" and "Create an account" links).
NEXT_PUBLIC_PACEWISE_URL=http://localhost:3000
# Optional: same Google client id as the main app, for "Continue with Google".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# The online backend, used when the local one above is not running (only when this app runs on localhost).
NEXT_PUBLIC_API_URL_ONLINE=https://pacewise-backend-o4qu.onrender.com/api/v1
